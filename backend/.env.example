# SmallBiz AI Operations Room - Backend Configuration Example
APP_NAME="SmallBiz AI Operations Room"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration (Neon PostgreSQL)
# Example: postgresql+psycopg://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql+psycopg://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# Switch Multi-Agent Orchestration Credentials
SWITCH_API_KEY=""
SWITCH_ROOM_ID="smallbiz-ops-room-q4"
SWITCH_ENDPOINT="https://api.switchagents.ai/v1"
